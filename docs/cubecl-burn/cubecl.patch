+/// Attributes are interned and immutable: read the `VecAttr` under `key`,
+/// edit the `idx`-th `DictAttr` of a copy (creating it and any lower slots
+/// empty), and store the copy back.
+fn modify_dict(
+    op: Ptr<Operation>,
+    ctx: &Context,
+    key: &Identifier,
+    idx: usize,
+    f: impl FnOnce(&mut DictAttr),
+) {
+    let mut op = op.deref_mut(ctx);
+    let mut vec = op
+        .attributes
+        .get::<VecAttr>(ctx, key)
+        .cloned()
+        .unwrap_or_else(|| VecAttr::new(vec![]));
+    while vec.0.len() <= idx {
+        vec.0.push(Box::new(DictAttr::new(ctx, vec![])));
+    }
+    f(vec.0[idx].downcast_mut::<DictAttr>().expect("Should be `DictAttr`"));
+    op.attributes.set(ctx, key.clone(), vec);
+}
