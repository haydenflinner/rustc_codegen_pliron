+/// `CUBECL_PLIRON_LOG=1`: one stderr line per compiled kernel naming the
+/// path that built it (`clif` = pliron -> Cranelift, `llvm` = LLVM), the
+/// object size, and codegen / codegen+load wall time in microseconds.
+///
+/// `CUBECL_PLIRON_LOG=<anything but 1>` appends the line to that file instead
+/// (test harnesses capture stderr). `CUBECL_PLIRON_DUMP_OBJ=<dir>` also writes
+/// `<dir>/<kernel>.<path>.o` for `llvm-objdump -d`.
+fn jit_log(path: &str, kernel: &str, object: &[u8], codegen: std::time::Duration, total: std::time::Duration) {
+    if let Some(v) = std::env::var_os("CUBECL_PLIRON_LOG") {
+        let line = format!(
+            "[cubecl-pliron] path={path} kernel={kernel} obj_bytes={} codegen_us={} total_us={}",
+            object.len(),
+            codegen.as_micros(),
+            total.as_micros()
+        );
+        if v == "1" {
+            eprintln!("{line}");
+        } else if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(&v) {
+            use std::io::Write;
+            let _ = writeln!(f, "{line}");
+        }
+    }
+    if let Some(dir) = std::env::var_os("CUBECL_PLIRON_DUMP_OBJ") {
+        let _ = std::fs::create_dir_all(&dir);
+        let _ = std::fs::write(std::path::Path::new(&dir).join(format!("{kernel}.{path}.o")), object);
+    }
+}
