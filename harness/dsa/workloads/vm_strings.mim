// String building: f-string formatting, `contains`, `to_upper`, `len`
// (allocation + GC churn). After mimas/benchmarks/strings.
const N = 250000;

let total_len = 0;
let hits = 0;
for i in N {
    let s = f"item_{i mod 128}_value";
    total_len += s.len();
    if s.contains("7") {
        hits += 1;
    }
    let u = s.to_upper();
    total_len += u.len();
}
print(total_len);
print(hits);
