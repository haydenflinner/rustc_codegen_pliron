;; PLIRON: pure rewrites migrated from pliron-clif-opt's `clifpeep` sweep
;; (docs/codegen-plan.md, "Direction": equality as an invariant, then the
;; egraph). Each family here mirrors a Rust rule whose hit counter
;; (`rule:<name>` under PLIRON_STATS) must drop to zero on the corpus
;; before the Rust rule is deleted. Default since 11-04; `PLIRON_EGRAPH_RULES=0`
;; disables.

(decl pure pliron_rules_on () bool)
(extern constructor pliron_rules_on pliron_rules_on)

;;;; addnorm: constant chains on an additive spine fold once.
;; cprop pushes immediates to the right of `iadd`, so only right-constant
;; shapes are needed; `isub k, x` is already `ineg (isub x k)`.

;; (x + k1) + k2 --> x + (k1 + k2)
(rule (simplify (iadd (fits_in_64 ty) (iadd ty x (iconst ty k1)) (iconst ty k2)))
      (if-let true (pliron_rules_on))
      (iadd ty x (iconst ty (imm64_add ty k1 k2))))
;; (x + k1) - k2 --> x + (k1 - k2)
(rule (simplify (isub (fits_in_64 ty) (iadd ty x (iconst ty k1)) (iconst ty k2)))
      (if-let true (pliron_rules_on))
      (iadd ty x (iconst ty (imm64_sub ty k1 k2))))
;; (x - k1) + k2 --> x + (k2 - k1)
(rule (simplify (iadd (fits_in_64 ty) (isub ty x (iconst ty k1)) (iconst ty k2)))
      (if-let true (pliron_rules_on))
      (iadd ty x (iconst ty (imm64_sub ty k2 k1))))
;; (x - k1) - k2 --> x - (k1 + k2)
(rule (simplify (isub (fits_in_64 ty) (isub ty x (iconst ty k1)) (iconst ty k2)))
      (if-let true (pliron_rules_on))
      (isub ty x (iconst ty (imm64_add ty k1 k2))))

;;;; icmpk: a constant on an additive spine moves across an equality.
;; (x + k) ==/!= c --> x ==/!= (c - k)
(rule (simplify (eq cty (iadd (fits_in_64 ty) x (iconst ty k)) (iconst ty c)))
      (if-let true (pliron_rules_on))
      (eq cty x (iconst ty (imm64_sub ty c k))))
(rule (simplify (ne cty (iadd (fits_in_64 ty) x (iconst ty k)) (iconst ty c)))
      (if-let true (pliron_rules_on))
      (ne cty x (iconst ty (imm64_sub ty c k))))
;; (x - k) ==/!= c --> x ==/!= (c + k)
(rule (simplify (eq cty (isub (fits_in_64 ty) x (iconst ty k)) (iconst ty c)))
      (if-let true (pliron_rules_on))
      (eq cty x (iconst ty (imm64_add ty c k))))
(rule (simplify (ne cty (isub (fits_in_64 ty) x (iconst ty k)) (iconst ty c)))
      (if-let true (pliron_rules_on))
      (ne cty x (iconst ty (imm64_add ty c k))))
;; (a - b) ==/!= 0 --> a ==/!= b
(rule (simplify (eq cty (isub (fits_in_64 ty) a b) (iconst_u ty 0)))
      (if-let true (pliron_rules_on))
      (eq cty a b))
(rule (simplify (ne cty (isub (fits_in_64 ty) a b) (iconst_u ty 0)))
      (if-let true (pliron_rules_on))
      (ne cty a b))
;; (x + k) ==/!= y  with y = (z + k) is cranelift's own rule; -x ==/!= c --> x ==/!= -c
(rule (simplify (eq cty (ineg (fits_in_64 ty) x) (iconst ty c)))
      (if-let true (pliron_rules_on))
      (eq cty x (iconst ty (imm64_neg ty c))))
(rule (simplify (ne cty (ineg (fits_in_64 ty) x) (iconst ty c)))
      (if-let true (pliron_rules_on))
      (ne cty x (iconst ty (imm64_neg ty c))))

;;;; fcmpfold (PLIRON_FCMPFOLD=1, opt-in): a compare of two float constants
;; is a constant. Upstream's cprop leaves `fcmp` as a TODO; nalgebra's
;; `gemv` tests `!beta.is_zero()` on a `beta` that is the constant 0.0
;; or 1.0 once its store is forwarded, and the untaken arm keeps a
;; second copy of every loop.
(decl pure pliron_fcmpfold_on () bool)
(extern constructor pliron_fcmpfold_on pliron_fcmpfold_on)
(decl pure f32_cmp_fold (FloatCC Ieee32 Ieee32) u64)
(extern constructor f32_cmp_fold f32_cmp_fold)
(decl pure f64_cmp_fold (FloatCC Ieee64 Ieee64) u64)
(extern constructor f64_cmp_fold f64_cmp_fold)
(rule (simplify (fcmp (fits_in_64 ty) cc (f32const $F32 a) (f32const $F32 b)))
      (if-let true (pliron_fcmpfold_on))
      (subsume (iconst_u ty (f32_cmp_fold cc a b))))
(rule (simplify (fcmp (fits_in_64 ty) cc (f64const $F64 a) (f64const $F64 b)))
      (if-let true (pliron_fcmpfold_on))
      (subsume (iconst_u ty (f64_cmp_fold cc a b))))

;;;; fmul1 (PLIRON_FMUL1=1, opt-in): x * 1.0 --> x. Exact for every
;; non-NaN x (including -0.0 and infinities); for a NaN x the result is
;; a NaN either way, and Rust leaves the payload (and, for a signaling
;; input, the quiet bit) of an arithmetic NaN unspecified, which is why
;; LLVM folds it too. nalgebra's `gemm` passes `alpha = 1.0` into every
;; `axcpy` (`y = a * x * c + b * y`).
(decl pure pliron_fmul1_on () bool)
(extern constructor pliron_fmul1_on pliron_fmul1_on)
(rule (simplify (fmul $F32 x (f32const $F32 (u32_from_ieee32 0x3f800000))))
      (if-let true (pliron_fmul1_on))
      (subsume x))
(rule (simplify (fmul $F32 (f32const $F32 (u32_from_ieee32 0x3f800000)) x))
      (if-let true (pliron_fmul1_on))
      (subsume x))
(rule (simplify (fmul $F64 x (f64const $F64 (u64_from_ieee64 0x3ff0000000000000))))
      (if-let true (pliron_fmul1_on))
      (subsume x))
(rule (simplify (fmul $F64 (f64const $F64 (u64_from_ieee64 0x3ff0000000000000)) x))
      (if-let true (pliron_fmul1_on))
      (subsume x))

;;;; PLIRON (`PLIRON_MINCMP`, default on since 2026-11-22, `=0` off): a value clamped to `y` is never
;; above it, and `y` never below it — the negations of upstream's
;; `ule (umin x y) y` rules. lol_html's `Bytes::slice` clamps a range to the
;; input's length with `min` and then bounds-checks the clamped value
;; against the same length: three dead `cmp; b.hi` per attribute in
;; `Attributes::init_items`.
(decl pure pliron_mincmp_on () bool)
(extern constructor pliron_mincmp_on pliron_mincmp_on)
(rule (simplify (ugt (ty_int ty) (umin _ x y) y)) (if-let true (pliron_mincmp_on)) (iconst_u ty 0))
(rule (simplify (ugt (ty_int ty) (umin _ y x) y)) (if-let true (pliron_mincmp_on)) (iconst_u ty 0))
(rule (simplify (ult (ty_int ty) y (umin _ x y))) (if-let true (pliron_mincmp_on)) (iconst_u ty 0))
(rule (simplify (ult (ty_int ty) y (umin _ y x))) (if-let true (pliron_mincmp_on)) (iconst_u ty 0))
(rule (simplify (ult (ty_int ty) (umax _ x y) y)) (if-let true (pliron_mincmp_on)) (iconst_u ty 0))
(rule (simplify (ult (ty_int ty) (umax _ y x) y)) (if-let true (pliron_mincmp_on)) (iconst_u ty 0))
(rule (simplify (ugt (ty_int ty) y (umax _ x y))) (if-let true (pliron_mincmp_on)) (iconst_u ty 0))
(rule (simplify (ugt (ty_int ty) y (umax _ y x))) (if-let true (pliron_mincmp_on)) (iconst_u ty 0))
;; The true forms. Upstream's `(ule ty (umin ty x y) x)` family binds one
;; `ty` to the compare's result type and the operands' type, so it never
;; matches a scalar compare (`i8` result, `i64` operands).
(rule (simplify (ule (ty_int ty) (umin _ x y) y)) (if-let true (pliron_mincmp_on)) (iconst_u ty 1))
(rule (simplify (ule (ty_int ty) (umin _ y x) y)) (if-let true (pliron_mincmp_on)) (iconst_u ty 1))
(rule (simplify (uge (ty_int ty) y (umin _ x y))) (if-let true (pliron_mincmp_on)) (iconst_u ty 1))
(rule (simplify (uge (ty_int ty) y (umin _ y x))) (if-let true (pliron_mincmp_on)) (iconst_u ty 1))
(rule (simplify (uge (ty_int ty) (umax _ x y) y)) (if-let true (pliron_mincmp_on)) (iconst_u ty 1))
(rule (simplify (uge (ty_int ty) (umax _ y x) y)) (if-let true (pliron_mincmp_on)) (iconst_u ty 1))
(rule (simplify (ule (ty_int ty) y (umax _ x y))) (if-let true (pliron_mincmp_on)) (iconst_u ty 1))
(rule (simplify (ule (ty_int ty) y (umax _ y x))) (if-let true (pliron_mincmp_on)) (iconst_u ty 1))
(rule (simplify (sle (ty_int ty) (smin _ x y) y)) (if-let true (pliron_mincmp_on)) (iconst_u ty 1))
(rule (simplify (sle (ty_int ty) (smin _ y x) y)) (if-let true (pliron_mincmp_on)) (iconst_u ty 1))
(rule (simplify (sge (ty_int ty) (smax _ x y) y)) (if-let true (pliron_mincmp_on)) (iconst_u ty 1))
(rule (simplify (sge (ty_int ty) (smax _ y x) y)) (if-let true (pliron_mincmp_on)) (iconst_u ty 1))
(rule (simplify (sgt (ty_int ty) (smin _ x y) y)) (if-let true (pliron_mincmp_on)) (iconst_u ty 0))
(rule (simplify (sgt (ty_int ty) (smin _ y x) y)) (if-let true (pliron_mincmp_on)) (iconst_u ty 0))
(rule (simplify (slt (ty_int ty) (smax _ x y) y)) (if-let true (pliron_mincmp_on)) (iconst_u ty 0))
(rule (simplify (slt (ty_int ty) (smax _ y x) y)) (if-let true (pliron_mincmp_on)) (iconst_u ty 0))

;; PLIRON (`PLIRON_LOWBITS=1`, opt-in, 2026-11-22): known low zero bits of
;; a product or a shift. hashbrown's `calculate_layout_for` rounds `48 * n +
;; 7` down to 8 (`& -8`) and tests the `+ 7` for overflow: `48 * n` ends in
;; four zero bits, so the mask is a no-op and the add cannot wrap (LLVM's
;; known bits fold both). i64 only.
(decl pure pliron_lowbits_on () bool)
(extern constructor pliron_lowbits_on pliron_lowbits_on)
;; `k` (the product's constant factor) has a trailing-zero count `t`; true
;; when `c < 2^t` and `m` clears only bits below `2^t` that `c` may set
;; (`m = -(2^s)`, `c < 2^s <= 2^t`).
(decl pure pliron_lowbits_mask (u64 u64 u64) bool)
(extern constructor pliron_lowbits_mask pliron_lowbits_mask)
;; True when `0 < c < 2^tz(k)`: `x * k + c` never wraps.
(decl pure pliron_lowbits_nowrap (u64 u64) bool)
(extern constructor pliron_lowbits_nowrap pliron_lowbits_nowrap)
(decl pure pliron_shl_factor (u64) u64)
(extern constructor pliron_shl_factor pliron_shl_factor)

(rule (simplify (band $I64 (iadd $I64 p @ (imul $I64 _ (iconst_u _ k)) (iconst_u _ c)) (iconst_u _ m)))
      (if-let true (pliron_lowbits_on))
      (if-let true (pliron_lowbits_mask k c m))
      (subsume p))
(rule (simplify (band $I64 (iadd $I64 p @ (ishl $I64 _ (iconst_u _ sh)) (iconst_u _ c)) (iconst_u _ m)))
      (if-let true (pliron_lowbits_on))
      (if-let true (pliron_lowbits_mask (pliron_shl_factor sh) c m))
      (subsume p))
(rule (simplify (ult (ty_int ty) (iadd $I64 p @ (imul $I64 _ (iconst_u _ k)) (iconst_u _ c)) p))
      (if-let true (pliron_lowbits_on))
      (if-let true (pliron_lowbits_nowrap k c))
      (iconst_u ty 0))
(rule (simplify (uge (ty_int ty) (iadd $I64 p @ (imul $I64 _ (iconst_u _ k)) (iconst_u _ c)) p))
      (if-let true (pliron_lowbits_on))
      (if-let true (pliron_lowbits_nowrap k c))
      (iconst_u ty 1))
(rule (simplify (ugt (ty_int ty) p @ (imul $I64 _ (iconst_u _ k)) (iadd $I64 p (iconst_u _ c))))
      (if-let true (pliron_lowbits_on))
      (if-let true (pliron_lowbits_nowrap k c))
      (iconst_u ty 0))
(rule (simplify (ult (ty_int ty) (iadd $I64 p @ (ishl $I64 _ (iconst_u _ sh)) (iconst_u _ c)) p))
      (if-let true (pliron_lowbits_on))
      (if-let true (pliron_lowbits_nowrap (pliron_shl_factor sh) c))
      (iconst_u ty 0))
;; The same with the constant factor on the left (`imul 48, n`).
(rule (simplify (band $I64 (iadd $I64 p @ (imul $I64 (iconst_u _ k) _) (iconst_u _ c)) (iconst_u _ m)))
      (if-let true (pliron_lowbits_on))
      (if-let true (pliron_lowbits_mask k c m))
      (subsume p))
(rule (simplify (ult (ty_int ty) (iadd $I64 p @ (imul $I64 (iconst_u _ k) _) (iconst_u _ c)) p))
      (if-let true (pliron_lowbits_on))
      (if-let true (pliron_lowbits_nowrap k c))
      (iconst_u ty 0))
(rule (simplify (uge (ty_int ty) (iadd $I64 p @ (imul $I64 (iconst_u _ k) _) (iconst_u _ c)) p))
      (if-let true (pliron_lowbits_on))
      (if-let true (pliron_lowbits_nowrap k c))
      (iconst_u ty 1))
(rule (simplify (ugt (ty_int ty) p @ (imul $I64 (iconst_u _ k) _) (iadd $I64 p (iconst_u _ c))))
      (if-let true (pliron_lowbits_on))
      (if-let true (pliron_lowbits_nowrap k c))
      (iconst_u ty 0))
