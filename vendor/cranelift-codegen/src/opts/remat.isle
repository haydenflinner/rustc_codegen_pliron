;; Rematerialize ALU-op-with-imm and iconsts in each block where they're
;; used. This is neutral (add-with-imm) or positive (iconst) for
;; register pressure, and these ops are very cheap.
;; PLIRON: only when the immediate folds into the operand — a remat
;; that must keep the constant in a register anyway buys no pressure
;; and re-executes the op at every use (hmget's loop re-xored a
;; hasher key with a 64-bit constant per iteration).
(rule (simplify x @ (iadd _ (iconst ty k) _))
      (if (imm64_addsub_imm ty k))
      (remat x))
(rule (simplify x @ (iadd _ _ (iconst ty k)))
      (if (imm64_addsub_imm ty k))
      (remat x))
(rule (simplify x @ (isub _ (iconst ty k) _))
      (if (imm64_addsub_imm ty k))
      (remat x))
(rule (simplify x @ (isub _ _ (iconst ty k)))
      (if (imm64_addsub_imm ty k))
      (remat x))
(rule (simplify x @ (band _ (iconst ty k) _))
      (if (imm64_logic_imm ty k))
      (remat x))
(rule (simplify x @ (band _ _ (iconst ty k)))
      (if (imm64_logic_imm ty k))
      (remat x))
(rule (simplify x @ (bor _ (iconst ty k) _))
      (if (imm64_logic_imm ty k))
      (remat x))
(rule (simplify x @ (bor _ _ (iconst ty k)))
      (if (imm64_logic_imm ty k))
      (remat x))
(rule (simplify x @ (bxor _ (iconst ty k) _))
      (if (imm64_logic_imm ty k))
      (remat x))
(rule (simplify x @ (bxor _ _ (iconst ty k)))
      (if (imm64_logic_imm ty k))
      (remat x))
(rule (simplify x @ (bnot _ _))
      (remat x))
;; PLIRON: only remat immediates that encode in one instruction — a
;; full-width `iconst` costs a movz/movk chain per use on aarch64,
;; which is strictly worse than pinning a vreg inside a loop.
(rule (simplify x @ (iconst ty k))
      (if (imm64_remat_cheap ty k))
      (remat x))
(rule (simplify x @ (f32const _ _))
      (remat x))
(rule (simplify x @ (f64const _ _))
      (remat x))
;; PLIRON: a `splat` of a materializable constant is one `movi`/`dup` at
;; the use — far cheaper than the spill reload a long-lived vector value
;; gets in hot loops (hashbrown probe loops spilled the EMPTY splat).
(rule (simplify x @ (splat _ (iconst _ _)))
      (remat x))
(rule (simplify x @ (splat _ (f32const _ _)))
      (remat x))
(rule (simplify x @ (splat _ (f64const _ _)))
      (remat x))
