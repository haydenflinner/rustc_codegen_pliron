@schema {id crate:tracey-config@1, cli tracey}

// rustc_codegen_pliron specification -- see spec/README.md.
//
// The spec is Typst (spec/chapters/*.typ); requirements are `#r("id", ..)[..]`.
// Code cites them as `// r[impl id]` and tests as `// r[verify id]`; the
// Python and shell harness uses `# r[..]`. test.sh stanzas carry
// `# r[verify id]` for each requirement whose `checked:` names them.
// vendor/ is excluded: patches there are cited from the PLIRON_PATCH.md
// notes, not annotated in place.
specs (
    {
        name pliron
        include (spec/chapters/*.typ)
        impls (
            {
                name main
                include (
                    src/**/*.rs
                    pliron-cfg/src/**/*.rs
                    pliron-ir-opt/src/**/*.rs
                    pliron-clif-lower/src/**/*.rs
                    pliron-clif-opt/src/**/*.rs
                    pliron-clif-check/src/**/*.rs
                    tools/**/*.rs
                    tests/**/*.rs
                    pliron-ir-opt/tests/**/*.rs
                    pliron-clif-opt/tests/**/*.rs
                    harness/*.py
                    harness/**/*.py
                    harness/*.sh
                    test.sh
                    tests/**/*.sh
                    selfhost/*.sh
                    bench/*.sh
                    bench/**/*.sh
                )
                exclude (
                    **/target/**
                    vendor/**
                    **/__pycache__/**
                    **/node_modules/**
                )
                test_include (
                    tests/**/*.rs
                    pliron-ir-opt/tests/**/*.rs
                    pliron-clif-opt/tests/**/*.rs
                )
            }
        )
    }
)
