; test brif_zh
; `brif (x == 0)` swaps to `brif x` with the arms exchanged (the likely
; nonzero successor becomes the wasm `if` then-arm); `x == 7` becomes
; `x != 7`. Semantics must not change on any input.
; check: brif v0, block2, block1
; check: brif v9, block4, block3(v0)
; check: ne v1, v5
; diffcheck
function %zh(i32, i32) -> i32 fast {
block0(v0: i32, v1: i32):
    v2 = iconst.i32 0
    v3 = icmp eq v0, v2
    brif v3, block1, block2

block1:
    v4 = iconst.i32 100
    return v4

block2:
    v5 = iconst.i32 7
    v6 = icmp eq v1, v5
    brif v6, block3(v0), block4

block3(v7: i32):
    return v7

block4:
    v8 = iadd v0, v1
    return v8
}
