; test ivrefold
; diffcheck
; The index steps by a param bound to the same iconst on every edge
; (a threaded `+ stride` that lowering kept as a slot): pkonst resolves
; it as a literal step, the pointer params `base + i'` refold onto the
; index, and the const param strips as same-value-on-every-edge.
; check: block1(v2: i64):
; check-not: block1(v2: i64, v3: i64, v4: i64, v5: i64):
function %f(i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v10: i64):
    v11 = iconst.i64 0
    v20 = iconst.i64 1
    jump block1(v11, v20, v0, v1)

block1(v2: i64, v3: i64, v4: i64, v5: i64):
    v6 = load.i8 notrap v4
    v7 = load.i8 notrap v5
    v8 = icmp ne v6, v7
    brif v8, block3(v2), block2

block2:
    v9 = iadd v2, v3
    v12 = iadd v0, v9
    v13 = iadd v9, v1
    v14 = icmp ult v9, v10
    brif v14, block1(v9, v20, v12, v13), block3(v10)

block3(v15: i64):
    return v15
}
