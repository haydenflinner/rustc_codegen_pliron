; test slp
; Unrolled-tile shape (CubeCL `simple_unit` GEMM): each lane is
; `load acc[k]; fma; store acc[k]` with the loads of lanes 1..3 sitting
; *between* member stores, and addresses built as `(idx + lane)*4` —
; `base_off` can't see through the `imul`, and the old span rule rejected
; any inst between member stores. The pack must merge lanes into f32x4
; while proving each load reads pre-store bytes.
; check: splat.f32x4
; check: load.f32x4
; check-not: store.f32
; diffcheck
function %fma_rmw(i64) {
    ss0 = explicit_slot 64, align = 16
    ss1 = explicit_slot 64, align = 16
block0(v8: i64):
    v10 = stack_addr.i64 ss0
    v11 = stack_addr.i64 ss1
    v6 = f32const 0x1.8p0
    v20 = iconst.i64 4
    v21 = iconst.i64 0
    v22 = iconst.i64 1
    v23 = iconst.i64 2
    v24 = iconst.i64 3
    ; lane 0
    v30 = iadd v8, v21
    v31 = imul v30, v20
    v32 = iadd v11, v31
    v33 = iadd v10, v31
    v34 = load.f32 notrap v32
    v35 = load.f32 notrap v33
    v36 = fma v6, v35, v34
    store.f32 notrap v36, v32
    ; lane 1
    v40 = iadd v8, v22
    v41 = imul v40, v20
    v42 = iadd v11, v41
    v43 = iadd v10, v41
    v44 = load.f32 notrap v42
    v45 = load.f32 notrap v43
    v46 = fma v6, v45, v44
    store.f32 notrap v46, v42
    ; lane 2
    v50 = iadd v8, v23
    v51 = imul v50, v20
    v52 = iadd v11, v51
    v53 = iadd v10, v51
    v54 = load.f32 notrap v52
    v55 = load.f32 notrap v53
    v56 = fma v6, v55, v54
    store.f32 notrap v56, v52
    ; lane 3
    v60 = iadd v8, v24
    v61 = imul v60, v20
    v62 = iadd v11, v61
    v63 = iadd v10, v61
    v64 = load.f32 notrap v62
    v65 = load.f32 notrap v63
    v66 = fma v6, v65, v64
    store.f32 notrap v66, v62
    return
}
