; test webmerge
; Sibling-slot affine: every edge's slot-1 arg is `slot-0 arg + 8` —
; `p1 = p0 + 8` paramizes to `P(0) + 8` on both edges even though the
; slot-0 args differ (`v0` vs `v0 * 3`). `p1` drops, `p0` survives, and
; `p0 + 8` is materialized at the head.
; check: block3(v9: i64):
; check-not: block3(v9: i64, v10: i64)
; diffcheck
function %f(i64) -> i64 {
block0(v0: i64):
    v1 = iconst.i64 0
    v2 = icmp eq v0, v1
    brif v2, block1, block2

block1:
    v3 = iconst.i64 8
    v4 = iadd v0, v3
    jump block3(v0, v4)

block2:
    v5 = iconst.i64 3
    v6 = imul v0, v5
    v7 = iconst.i64 8
    v8 = iadd v6, v7
    jump block3(v6, v8)

block3(v9: i64, v10: i64):
    v11 = iadd v9, v10
    return v11
}
