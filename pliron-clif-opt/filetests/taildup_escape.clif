; test taildup
; The block3 merge's params escape into block4 (return) and block5
; (check), so block3 cannot be duplicated into its jump preds until the
; use-blocks are param'd — block5 also forwards v10 to block4. After
; the repair both preds get an inline copy of the check.
; check: block4(v
; check: block5(v
; check: bor.i32 v1,
; check: bor v4,
function %f(i64, i32) -> i64 {
block0(v0: i64, v1: i32):
    v2 = iconst.i32 2
    v3 = icmp slt v1, v2
    brif v3, block2, block1

block1:
    v4 = iconst.i32 7
    jump block3(v0, v4)

block2:
    jump block3(v0, v1)

block3(v10: i64, v11: i32):
    v20 = iconst.i32 32
    v21 = bor v11, v20
    v22 = iconst.i32 97
    v23 = isub v21, v22
    v24 = iconst.i32 26
    v25 = icmp ult v23, v24
    brif v25, block4, block5

block4:
    return v10

block5:
    v30 = iconst.i32 170
    v31 = icmp ult v11, v30
    brif v31, block4, block6

block6:
    v40 = iconst.i64 9
    return v40
}
