; test bcheck
; cobs::dec::decode_in_place: i8 iv + i64 stepped param and i64 len —
; narrow guard must not emit mixed-width uadd_overflow/icmp; the check
; goes the i128 wide path instead (was a verifier ICE at O3).

function u0:0(i64 sret, i64, i64) apple_aarch64 {
    ss0 = explicit_slot 24, align = 8
    ss1 = explicit_slot 16, align = 8
    ss2 = explicit_slot 16, align = 8
