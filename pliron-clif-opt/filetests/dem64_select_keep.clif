; test dem64
; The select stays i64 (its result is returned) while its sub-2^32 cond
; demotes: the old `band` def is removed, so the surviving select must
; read the cond's i32 twin (corpus smoke `main`: "inst has no results").
; check: v5 = select v8, v3, v4
; check-not: = band.i64
; diffcheck
function %g(i64) -> i64 fast {
block0(v0: i64):
    v1 = iconst.i64 1
    v2 = band v0, v1
    v3 = iconst.i64 0x1_0000_0005
    v4 = iconst.i64 0
    v5 = select v2, v3, v4
    return v5
}
