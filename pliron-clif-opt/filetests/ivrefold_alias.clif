; test ivrefold
; diffcheck
; Two pointers carried beside the index, each recomputed by the latch as
; `base + i'` (the zip/enumerate shape): both refold onto the index.
; check: block1(v2: i64):
; check-not: block1(v2: i64, v3: i64, v4: i64):
function %f(i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v10: i64):
    v11 = iconst.i64 0
    jump block1(v11, v0, v1)

block1(v2: i64, v3: i64, v4: i64):
    v5 = load.i8 notrap v3
    v6 = load.i8 notrap v4
    v7 = icmp eq v5, v6
    v8 = iconst.i64 1
    v9 = iadd v2, v8
    v12 = iadd v0, v9
    v13 = iadd v9, v1
    v14 = icmp ult v9, v10
    brif v7, block2, block3(v2)

block2:
    brif v14, block1(v9, v12, v13), block3(v10)

block3(v15: i64):
    return v15
}
