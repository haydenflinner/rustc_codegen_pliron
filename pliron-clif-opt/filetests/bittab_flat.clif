; test bittab
; Flat `bor` tree of `icmp eq x, k` over {1,2,4,6}: lo = 1, so the mask
; must place bits at k - lo = {0,1,3,5} (43), not at the raw constants —
; emitting 86 with `ushr (x - 1)` accepts {2,3,5,7} instead.
; check: isub
; check: iconst.i64 43
; check: ushr
; check-not: iconst.i64 86
; diffcheck
function %flat_lo(i32) -> i8 {
block0(v0: i32):
    v1 = iconst.i32 1
    v2 = icmp eq v0, v1
    v3 = iconst.i32 2
    v4 = icmp eq v0, v3
    v5 = bor v2, v4
    v6 = iconst.i32 4
    v7 = icmp eq v0, v6
    v8 = bor v5, v7
    v9 = iconst.i32 6
    v10 = icmp eq v0, v9
    v11 = bor v8, v10
    return v11
}
