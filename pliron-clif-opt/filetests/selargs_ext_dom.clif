; test selargs_ext
; Like `selargs_ext.clif`, but block4 reads block3's param `v12`
; directly (not as a branch argument). Skipping block3 on the non-null
; edge would leave that use undefined there (regalloc2 panicked on an
; entry live-in in serde_json's `deserialize_struct`), so the edge keeps
; going through block3.
; check: brif v4, block2(v5, v1), block3(v1, v2)
; check: brif v14, block5, block4(v13)
function %f(i64, i64) -> i64 {
    sig0 = (i64) -> i64 apple_aarch64
    fn0 = %alloc sig0

block0(v0: i64, v1: i64):
    v2 = call fn0(v1)
    v20 = iconst.i64 0
    v3 = icmp eq v2, v20
    v4 = uextend.i32 v3
    v5 = iconst.i64 1
    v6 = select v3, v5, v1
    v7 = select v3, v1, v2
    brif v4, block2(v6, v7), block3(v6, v7)

block2(v10: i64, v11: i64):
    return v10

block3(v12: i64, v13: i64):
    v14 = icmp ugt v1, v12
    brif v14, block5, block4(v13)

block4(v15: i64):
    v17 = iadd v15, v12
    return v17

block5:
    return v0
}
