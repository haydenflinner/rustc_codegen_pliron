; test ldmerge
; Four consecutive uload8s shift-assembled into one field (memcmp
; expansion) become a single load.i32; the i64 side becomes load.i64.
; The lone non-adjacent uload8 at +9 must stay a byte load.
;
; check: load.i32 notrap little v0
; check: load.i64 notrap little v0+4
; check: v13 -> v52
; check: v51 -> v54
function %f(i64) -> i64 {
block0(v0: i64):
    v1 = uload8.i32 notrap v0
    v2 = uload8.i32 notrap v0+1
    v3 = uload8.i32 notrap v0+2
    v4 = uload8.i32 notrap v0+3
    v5 = iconst.i32 8
    v6 = ishl v2, v5
    v7 = iconst.i32 16
    v8 = ishl v3, v7
    v9 = iconst.i32 24
    v10 = ishl v4, v9
    v11 = bor v1, v6
    v12 = bor v11, v8
    v13 = bor v12, v10
    v14 = uextend.i64 v13
    v20 = uload8.i64 notrap v0+4
    v21 = uload8.i64 notrap v0+5
    v22 = uload8.i64 notrap v0+6
    v23 = uload8.i64 notrap v0+7
    v24 = uload8.i64 notrap v0+8
    v25 = uload8.i64 notrap v0+9
    v26 = uload8.i64 notrap v0+10
    v27 = uload8.i64 notrap v0+11
    v30 = iconst.i64 8
    v31 = ishl v21, v30
    v32 = iconst.i64 16
    v33 = ishl v22, v32
    v34 = iconst.i64 24
    v35 = ishl v23, v34
    v36 = iconst.i64 32
    v37 = ishl v24, v36
    v38 = iconst.i64 40
    v39 = ishl v25, v38
    v40 = iconst.i64 48
    v41 = ishl v26, v40
    v42 = iconst.i64 56
    v43 = ishl v27, v42
    v44 = bor v20, v31
    v45 = bor v44, v33
    v46 = bor v45, v35
    v47 = bor v46, v37
    v48 = bor v47, v39
    v49 = bor v48, v41
    v50 = bor v49, v43
    v51 = bor v14, v50
    return v51
}
