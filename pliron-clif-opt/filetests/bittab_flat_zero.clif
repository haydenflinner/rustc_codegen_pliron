; test bittab
; Same fold with lo = 0 over {0,2,4,6}: no `isub`, mask uses raw bit
; positions (85).
; check: = 85
; check: ushr
; check-not: isub
; diffcheck
function %flat_zero(i32) -> i8 {
block0(v0: i32):
    v1 = iconst.i32 0
    v2 = icmp eq v0, v1
    v3 = iconst.i32 2
    v4 = icmp eq v0, v3
    v5 = bor v2, v4
    v6 = iconst.i32 4
    v7 = icmp eq v0, v6
    v8 = bor v5, v7
    v9 = iconst.i32 6
    v10 = icmp eq v0, v9
    v11 = bor v8, v10
    return v11
}
