; test dem64
; A demoted `select`'s condition is a truth test, not a low-word read: the
; i32 twin read the original i64 `band` after dem64 removed it (verifier:
; "defined by inst which has no block"; tokio `ScheduledIo::wake`). The
; sub-2^32 cond demotes with it; the wide one (`v8`) stays i64.
; check: = select v8,
; diffcheck
function %f(i64, i64) -> i32 fast {
block0(v0: i64, v1: i64):
    v2 = iconst.i64 1
    v3 = band v0, v2
    v4 = iconst.i64 5
    v5 = iconst.i64 0
    v6 = select v3, v4, v5
    v7 = ireduce.i32 v6
    v8 = bor v1, v2
    v9 = select v8, v4, v5
    v10 = ireduce.i32 v9
    v11 = iadd v7, v10
    return v11
}
