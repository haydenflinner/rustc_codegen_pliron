; test vrp
; Boundary and safety cases for the difference-bound fold: the guard
; gives `v1 - v0 >= 9`, which does NOT prove `v0 + 9 < v1`; and with no
; dominating fact at all an identical-shaped check must stay.
; check: icmp ult v7, v1
; check: icmp ult v11, v1
function %h(i64, i64) -> i8 {
block0(v0: i64, v1: i64):
    v2 = iconst.i64 8
    v3 = umin.i64 v1, v2
    v4 = isub.i64 v1, v3
    v5 = icmp ult v0, v4
    brif v5, block1, block2

block1:
    ; one past the guard's reach: v1 - v0 >= 9 does not fold this.
    v6 = iconst.i64 9
    v7 = iadd.i64 v0, v6
    v8 = icmp ult v7, v1
    brif v8, block3, block2

block3:
    ; past the folded icmp: still dominated by the same guard, but a
    ; fresh +9 copy must also stay (the fold can't chain off itself).
    v10 = iconst.i64 9
    v11 = iadd.i64 v0, v10
    v12 = icmp ult v11, v1
    return v12

block2:
    v9 = iconst.i8 0
    return v9
}
