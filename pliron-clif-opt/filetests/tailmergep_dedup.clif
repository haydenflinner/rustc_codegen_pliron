; test tailmergep_dedup
; Two return tails that store four fields through one pointer each
; (`v0` in one, `v1` in the other) and return it: the pointer is four
; operand occurrences that agree member by member, so the shared block
; takes it as one param (lol_html's `finish_tag_name` stored a 56-byte
; result through seven copies of `x0`). The differing payloads `v2`/`v3`
; and `v4`/`v5` (each stored twice) are two more params: three in all.
; check: jump block3(v2, v0, v4)
; check: block3(v7: i64, v8: i64, v9: i64):
; check: jump block3(v3, v1, v5)
function %f(i64, i64, i64, i64, i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64):
    brif v6, block1, block2

block1:
    store.i64 notrap v2, v0
    store.i64 notrap v4, v0+8
    store.i64 notrap v2, v0+16
    store.i64 notrap v4, v0+24
    return v0

block2:
    store.i64 notrap v3, v1
    store.i64 notrap v5, v1+8
    store.i64 notrap v3, v1+16
    store.i64 notrap v5, v1+24
    return v1
}
