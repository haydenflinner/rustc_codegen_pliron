; test ivexit
; diffcheck
; check: block1(v2: i64):
; check-not: block1(v2: i64, v3: i64):
function %f(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    ; p counts from v0, q from 0, both by 8; q is only returned
    v10 = iconst.i64 0
    jump block1(v0, v10)

block1(v2: i64, v3: i64):
    v4 = iconst.i64 8
    v5 = iadd v2, v4
    v6 = iadd v3, v4
    v7 = icmp ult v5, v1
    brif v7, block1(v5, v6), block2(v6)

block2(v8: i64):
    return v8
}
