; test armmerge
; check: select
; check-not: block2:
; check-not: block3:
function %f(i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v9: i64):
    jump block1(v0, v1)

block1(v6: i64, v7: i64):
    v2 = icmp slt v6, v7
    brif v2, block2, block3

block2:
    v10 = iadd v6, v7
    v11 = isub v10, v6
    jump block4(v10, v11)

block3:
    v12 = iadd v7, v6
    v13 = isub v12, v7
    jump block4(v12, v13)

block4(v3: i64, v4: i64):
    v5 = imul v3, v4
    return v5
}
