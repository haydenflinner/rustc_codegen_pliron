; test webmerge
; Negative: the sibling relation differs across edges — edge1 feeds
; `arg1 = arg0 + 8` but edge2 feeds `arg1 = arg0 + 4`, and the slot-0
; args differ too. Nothing is uniform and no merge fires.
; check: block3(v9: i64, v10: i64):
function %f(i64) -> i64 {
block0(v0: i64):
    v1 = iconst.i64 0
    v2 = icmp eq v0, v1
    brif v2, block1, block2

block1:
    v3 = iconst.i64 8
    v4 = iadd v0, v3
    jump block3(v0, v4)

block2:
    v5 = iconst.i64 3
    v6 = imul v0, v5
    v7 = iconst.i64 4
    v8 = iadd v6, v7
    jump block3(v6, v8)

block3(v9: i64, v10: i64):
    v11 = iadd v9, v10
    return v11
}
