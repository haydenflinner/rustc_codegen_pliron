; test looprot_sink
; diffcheck
; The header's increment (and its constant) feed only the back edge:
; they move to the latch before the rotation, so the latch clone tests
; the stepped index itself and no `i + 1` param is carried.
; check: v4 = iadd v27, v3
; check: v26 = icmp uge v4, v1
; check-not: block5(v27: i64, v28: i64, v
function %f(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v10 = iconst.i64 0
    jump block1(v10, v0)

block1(v2: i64, v20: i64):
    v3 = iconst.i64 1
    v4 = iadd v2, v3
    v5 = icmp ult v2, v1
    brif v5, block2, block3

block2:
    v7 = load.i8 notrap v20
    v22 = iconst.i64 1
    v21 = iadd v20, v22
    v23 = iconst.i8 0
    v8 = icmp eq v7, v23
    brif v8, block4(v20), block5

block5:
    jump block1(v4, v21)

block3:
    return v1

block4(v9: i64):
    return v9
}
